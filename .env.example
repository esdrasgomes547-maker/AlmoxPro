# Chave da API do Google Gemini (grátis): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Nome do assistente e do dono
BOT_NAME=Lev
OWNER_NAME=Esdras

# Gatilho para invocar o assistente em qualquer conversa (só funciona para VOCÊ)
TRIGGER=@LB

# Responder em grupos? (false = ignora grupos, mas o @LB seu funciona mesmo assim)
REPLY_TO_GROUPS=false

# Responder áudios com mensagem de voz? (false = responde áudios em texto)
VOICE_REPLIES=true

# Voz do TTS. Opções: Kore, Puck, Zephyr, Charon, Fenrir, Leda, Orus, Aoede
TTS_VOICE=Kore

# Modelos Gemini (deixe assim, a não ser que saiba o que está fazendo)
CHAT_MODEL=gemini-2.5-flash
TTS_MODEL=gemini-2.5-flash-preview-tts
IMAGE_MODEL=gemini-2.5-flash-image

# Nível de log: trace | debug | info | warn | error
LOG_LEVEL=info
