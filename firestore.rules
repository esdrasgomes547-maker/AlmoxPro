rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isMaster() { 
      return isSignedIn() && request.auth.token.role == 'master';
    }

    // premium_max -> cliente pagante ativo
    function isPremiumMax() {
      return isSignedIn() && request.auth.token.role == 'premium_max';
    }
    
    function isOrgMember(orgId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId;
    }

    // --- Validation Helpers ---
    
    function isValidInventoryItem(data) {
      return data.keys().hasAll(['name', 'category', 'location', 'qty', 'minQty', 'status', 'price']) &&
             data.keys().size() == 7 &&
             data.name is string && data.name.size() <= 100 &&
             data.category is string && data.category.size() <= 50 &&
             data.location is string && data.location.size() <= 50 &&
             data.qty is number &&
             data.minQty is number &&
             data.status in ["OK", "WARNING", "CRITICAL", "OUT_OF_STOCK"] &&
             data.price is number;
    }

    function isValidShipment(data) {
      return data.keys().hasAll(['destination', 'items', 'status', 'driver', 'vehicle', 'date']) &&
             data.keys().size() == 6 &&
             data.destination is string && data.destination.size() <= 200 &&
             data.items is number &&
             data.status is string && data.status.size() <= 50 &&
             data.driver is string && data.driver.size() <= 100 &&
             data.vehicle is string && data.vehicle.size() <= 100 &&
             data.date is string;
    }

    function isValidSupplier(data) {
      return data.keys().hasAll(['name', 'category', 'rating', 'phone', 'email', 'status']) &&
             data.keys().size() == 6 &&
             data.name is string && data.name.size() <= 100 &&
             data.category is string && data.category.size() <= 50 &&
             data.rating is number &&
             data.phone is string && data.phone.size() <= 20 &&
             data.email is string && data.email.size() <= 100 &&
             data.status is string && data.status.size() <= 50;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'description', 'purpose']) &&
             (data.keys().size() == 3 || (data.keys().size() == 4 && data.keys().hasAll(['photoUrl']))) &&
             data.name is string && data.name.size() <= 100 &&
             data.description is string && data.description.size() <= 200 &&
             data.purpose is string && data.purpose.size() <= 100 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 255));
    }

    // --- Rules ---

    // users/{uid} -> próprio usuário ou master
    match /users/{uid} {
      allow read, write: if isMaster() || (isSignedIn() && request.auth.uid == uid);
    }

    // subscriptions/{orgId} -> master ou isOrgMember(orgId) (só leitura para membro da org)
    match /subscriptions/{orgId} {
      allow read: if isMaster() || isOrgMember(orgId);
      allow write: if isMaster();
    }

    // organizations/{orgId} -> master ou (premium_max && isOrgMember(orgId))
    match /organizations/{orgId} {
      allow read: if isMaster() || (isPremiumMax() && isOrgMember(orgId));
      allow write: if isMaster();

      // Inventory
      match /inventory/{itemId} {
        allow read: if isMaster() || (isPremiumMax() && isOrgMember(orgId));
        allow create: if (isMaster() || (isPremiumMax() && isOrgMember(orgId))) && isValidInventoryItem(incoming());
        allow update: if (isMaster() || (isPremiumMax() && isOrgMember(orgId))) && isValidInventoryItem(incoming());
        allow delete: if isMaster() || (isPremiumMax() && isOrgMember(orgId));
      }

      // Shipments
      match /shipments/{shipmentId} {
        allow read: if isMaster() || (isPremiumMax() && isOrgMember(orgId));
        allow create: if (isMaster() || (isPremiumMax() && isOrgMember(orgId))) && isValidShipment(incoming());
        allow update: if (isMaster() || (isPremiumMax() && isOrgMember(orgId))) && isValidShipment(incoming());
        allow delete: if isMaster() || (isPremiumMax() && isOrgMember(orgId));
      }

      // Suppliers
      match /suppliers/{supplierId} {
        allow read: if isMaster() || (isPremiumMax() && isOrgMember(orgId));
        allow create: if (isMaster() || (isPremiumMax() && isOrgMember(orgId))) && isValidSupplier(incoming());
        allow update: if (isMaster() || (isPremiumMax() && isOrgMember(orgId))) && isValidSupplier(incoming());
        allow delete: if isMaster() || (isPremiumMax() && isOrgMember(orgId));
      }

      // Employees
      match /employees/{employeeId} {
        allow read: if isMaster() || (isPremiumMax() && isOrgMember(orgId));
        allow create, update, delete: if isMaster() || (isPremiumMax() && isOrgMember(orgId));
      }

      // Categories
      match /categories/{document=**} {
        allow read, list: if isMaster() || (isPremiumMax() && isOrgMember(orgId));
        allow create, update: if (isMaster() || (isPremiumMax() && isOrgMember(orgId))) && isValidCategory(incoming());
        allow delete: if isMaster() || (isPremiumMax() && isOrgMember(orgId));
      }

      // Settings
      match /settings/{settingsId} {
        allow read, write: if isMaster() || (isPremiumMax() && isOrgMember(orgId));
      }
    }
  }
}
